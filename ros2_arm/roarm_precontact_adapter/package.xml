<?xml version="1.0"?>
<package format="3">
  <name>roarm_precontact_adapter</name>
  <version>0.1.0</version>
  <description>Inert-by-default, outbound-only pre-contact admission action adapter. It creates no motion publisher or arm client in its current NOT_IMPLEMENTED executor path.</description>
  <maintainer email="noreply@example.com">Lift Robot team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>elevator_interfaces</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
