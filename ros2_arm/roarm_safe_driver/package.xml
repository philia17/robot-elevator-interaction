  <version>0.1.0</version>
  <description>Fail-closed ROS 2 serial driver for supervised RoArm-M3 joint validation.</description>
  <maintainer email="noreply@example.com">Lift Robot team</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>apriltag_msgs</exec_depend>
