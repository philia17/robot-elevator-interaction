<?xml version="1.0"?>
<package format="3">
  <name>elevator_bringup</name>
  <version>0.1.0</version>
  <description>Launch and configuration skeletons for elevator perception.</description>
  <maintainer email="maintainer@example.com">Elevator Perception Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>elevator_vision</exec_depend>
  <exec_depend>elevator_semantics</exec_depend>
  <exec_depend>elevator_pipeline</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
