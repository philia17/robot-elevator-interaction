<?xml version="1.0"?>
<package format="3">
  <name>elevator_pipeline</name>
  <version>0.1.0</version>
  <description>Pipeline orchestration skeleton nodes for elevator perception.</description>
  <maintainer email="maintainer@example.com">Elevator Perception Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>elevator_interfaces</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>elevator_semantics</test_depend>
  <test_depend>elevator_vision</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
